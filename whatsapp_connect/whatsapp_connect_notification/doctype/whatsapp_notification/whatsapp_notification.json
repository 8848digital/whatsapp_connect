  },
  {
   "fieldname": "column_break_trigger",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "document_event",
   "fieldtype": "Select",
   "label": "When",
   "options": "New\nSave\nSubmit\nCancel\nDelete\nValue Change\nSave After Submit",
   "depends_on": "eval:doc.event_type=='Document Event'",
   "mandatory_depends_on": "eval:doc.event_type=='Document Event'"
  },
  {
   "fieldname": "value_changed",
   "fieldtype": "Select",
   "label": "Field That Changes",
   "depends_on": "eval:doc.document_event=='Value Change'"
  },
  {
   "fieldname": "date_field",
   "fieldtype": "Select",
   "label": "Date Field",
