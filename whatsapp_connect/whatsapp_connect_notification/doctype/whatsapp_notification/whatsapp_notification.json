   "fieldtype": "Int",
   "label": "Days After the Date",
   "depends_on": "eval:doc.event_type=='Date Based'",
   "description": "Use a negative number for days before the date, for example -3."
  },
  {
   "fieldname": "frequency",
   "fieldtype": "Select",
   "label": "Frequency",
   "options": "Hourly\nDaily\nWeekly\nMonthly\nYearly",
   "depends_on": "eval:doc.event_type=='Scheduled'",
   "mandatory_depends_on": "eval:doc.event_type=='Scheduled'"
  },
  {
   "fieldname": "document_filters",
   "fieldtype": "Code",
   "label": "Document Filters",
   "options": "JSON",
   "depends_on": "eval:doc.event_type=='Scheduled' && doc.reference_doctype",
   "description": "Send for each document that matches, for example {\"status\": \"Overdue\"}."
  },
  {
   "fieldname": "condition",
   "fieldtype": "Code",
   "label": "Condition",
   "options": "Python",
   "description": "Optional. Send only when true, for example doc.status == \"Paid\"."
  },
  {
   "fieldname": "message_section",
   "fieldtype": "Section Break",
   "label": "Message"
